<Window x:Class="TomatoBuddy.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="番茄小伴 · 把时间留给喜欢的事" Width="1120" Height="780" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#FBF7F1" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Grid Margin="30,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,26"><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="15" Background="#E86F59"><Image Source="Assets/icon.png"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="番茄小伴" FontSize="21" FontWeight="Bold"/><TextBlock Text="TOMATO BUDDY  /  专注也可以很温柔" FontSize="10" Foreground="#9A8A7D" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="◷  专注" Click="ShowFocus" Margin="0,0,8,0"/><Button Content="▥  统计" Click="ShowStats" Margin="0,0,8,0"/><Button Content="⚙  设置" Click="ShowSettings"/></StackPanel></Grid>
  <Grid Grid.Row="1" x:Name="FocusPage"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#FFFDFA" CornerRadius="24" BorderBrush="#EEE5DA" BorderThickness="1" Padding="28,26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="给自己一段不被打扰的时光" FontSize="21" FontWeight="Bold"/><TextBlock Text="一次只做一件事，慢慢来，也很好。" Margin="0,9,0,20" Foreground="#9A8A7D"/></StackPanel>
    <UniformGrid Grid.Row="1" Columns="3"><Button x:Name="FocusTab" Content="专注" Tag="Focus" Click="SelectPhase" Margin="0,0,5,0"/><Button x:Name="ShortTab" Content="短休息" Tag="ShortBreak" Click="SelectPhase" Margin="5,0,5,0"/><Button x:Name="LongTab" Content="长休息" Tag="LongBreak" Click="SelectPhase" Margin="5,0,0,0"/></UniformGrid>
    <Viewbox Grid.Row="2" Margin="0,12,0,12" Stretch="Uniform"><Grid Width="278" Height="278"><Ellipse Stroke="#F4ECE2" StrokeThickness="10"/><Path x:Name="ProgressArc" Stroke="#E87760" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="PhaseLabel" Text="准备好开始了吗" Foreground="#A18E80" HorizontalAlignment="Center" FontSize="13"/><TextBlock x:Name="TimeLabel" Text="25:00" FontFamily="Segoe UI" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,3"/><TextBlock x:Name="RoundLabel" Text="第 1 / 4 颗番茄" Foreground="#A18E80" HorizontalAlignment="Center"/></StackPanel></Grid></Viewbox>
    <StackPanel Grid.Row="3"><TextBlock Text="这次，想专心做什么？" FontSize="12" Foreground="#9A8A7D" Margin="0,0,0,8"/><TextBox x:Name="TaskInput" MaxLength="100" ToolTip="为这次专注起个名字（可选）" LostFocus="SaveTask"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="▶  开始专注" Background="#E87760" Foreground="White" FontWeight="Bold" FontSize="16" Padding="24,14" Click="ToggleTimer"/><Button Grid.Column="2" Content="↺" FontSize="22" Padding="19,8" Click="ResetTimer" ToolTip="重置本轮"/></Grid></StackPanel>
    <TextBlock Grid.Row="4" Text="专注一会儿，记得也照顾一下自己。" FontSize="11" Foreground="#A79687" HorizontalAlignment="Center" Margin="0,16,0,0"/>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#F7EBDD" CornerRadius="24" ClipToBounds="True"><Grid><Image x:Name="HeroImage" Stretch="UniformToFill"/><Border Background="#EFFFF8EE" VerticalAlignment="Top" Margin="22" Padding="16,12" CornerRadius="14"><StackPanel><TextBlock Text="小小番茄，大大能量。" FontSize="20" FontWeight="Bold"/><TextBlock Text="你的专注小伙伴，今天也在这里陪你。" FontSize="12" Foreground="#9A7F69" Margin="0,7,0,0"/></StackPanel></Border><Border Background="#EEFFFCF7" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18" Padding="16,9"><TextBlock x:Name="CompanionText" Text="✦  准备好啦，陪你种下今天的第一颗番茄" FontSize="12" Foreground="#94765E"/></Border></Grid></Border>
    <Border Grid.Row="2" Background="#EDF0E5" CornerRadius="20" Padding="22,19"><StackPanel><Grid><TextBlock Text="今天的收获" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="DateLabel" HorizontalAlignment="Right" Foreground="#899278" FontSize="12"/></Grid><UniformGrid Columns="3" Margin="0,17,0,4"><StackPanel><TextBlock x:Name="TodayCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="完成番茄" Foreground="#889178" FontSize="11"/></StackPanel><StackPanel><TextBlock x:Name="TodayMinutes" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="专注分钟" Foreground="#889178" FontSize="11"/></StackPanel><StackPanel><TextBlock x:Name="StreakLabel" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="连续天数" Foreground="#889178" FontSize="11"/></StackPanel></UniformGrid></StackPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="1" x:Name="StatsPage" Visibility="Collapsed" Background="#FFFDFA" CornerRadius="24" Padding="30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="每一份专注，都算数。" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="HarvestLabel" Foreground="#87936F" Margin="0,12,0,0"/><TextBlock x:Name="StatsSummary" Foreground="#9A8A7D" Margin="0,10,0,20"/></StackPanel><UniformGrid x:Name="WeekBars" Grid.Row="1" Columns="7" Height="160" Margin="0,0,0,24"/><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button Content="导出 CSV" DockPanel.Dock="Right" Click="Export"/><TextBlock Text="最近的专注记录" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="休息果园 · 按天收获" FontSize="16" FontWeight="Bold"/><StackPanel x:Name="HarvestList" Margin="0,5,0,16"/><StackPanel x:Name="SessionList"/></StackPanel></ScrollViewer></Grid></Grid></Border>
  <Border Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" Background="#FFFDFA" CornerRadius="24" Padding="30"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="找到自己的节奏" FontSize="25" FontWeight="Bold"/><TextBlock Text="设置会保存在这台电脑。时长调整从下一轮开始生效。" Foreground="#9A8A7D" Margin="0,10,0,25"/><UniformGrid Columns="4"><StackPanel Margin="0,0,18,0"><TextBlock Text="专注 / 分钟" Margin="0,0,0,9"/><TextBox x:Name="FocusInput"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="短休息 / 分钟" Margin="0,0,0,9"/><TextBox x:Name="ShortInput"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="长休息 / 分钟" Margin="0,0,0,9"/><TextBox x:Name="LongInput"/></StackPanel><StackPanel><TextBlock Text="每几轮长休息" Margin="0,0,0,9"/><TextBox x:Name="IntervalInput"/></StackPanel></UniformGrid><TextBlock Text="提醒与节奏" FontSize="17" FontWeight="Bold" Margin="0,27,0,6"/><CheckBox x:Name="SoundInput" Content="完成时播放提示音"/><CheckBox x:Name="AutoBreakInput" Content="专注结束后，自动开始休息"/><CheckBox x:Name="AutoFocusInput" Content="休息结束后，自动开始下一轮专注"/><CheckBox x:Name="StrictRestInput" Content="强制休息：全屏覆盖所有显示器，休息结束自动解除"/><StackPanel Orientation="Horizontal" Margin="0,8,0,10"><TextBlock Text="休息场景" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="SceneInput" Width="210" FontSize="14" Padding="10"><ComboBoxItem Content="番茄苗 · 慢慢结出一颗果子"/><ComboBoxItem Content="番茄小人 · 快乐跳舞"/><ComboBoxItem Content="护眼远眺 · 远看与轻眨眼"/><ComboBoxItem Content="椅上轻活动 · 肩膀与脚踝"/><ComboBoxItem Content="安静放松 · 自然呼吸"/></ComboBox><Button Content="预览 12 秒" Click="PreviewRest" Margin="15,0,0,0"/></StackPanel><TextBlock Text="强制模式自动开始休息，禁止暂停、切换与普通关闭。&#x0a;紧急退出：Ctrl + Alt + Shift + F12，本轮不计果子。系统安全快捷键保持可用。" Foreground="#9A8A7D" FontSize="12" TextWrapping="Wrap"/><CheckBox x:Name="BreakWindowInput" Content="非强制模式：显示普通休息提醒窗口"/><TextBlock Text="关闭主窗口后继续在系统托盘计时；从托盘菜单可彻底退出。&#x0a;电脑睡眠期间按自然时间计算，唤醒时只结算当前一轮。" Foreground="#9A8A7D" Margin="0,16,0,20" LineHeight="24"/><Button Content="保存设置" Click="SaveSettings" Background="#E87760" Foreground="White" HorizontalAlignment="Left" Padding="30,13"/><TextBlock x:Name="SettingsMessage" Margin="0,12,0,0" Foreground="#8B9978"/></StackPanel></ScrollViewer></Border>
  <DockPanel Grid.Row="2" Margin="3,19,3,0"><TextBlock Text="✦  本地存储 · 无需登录" Foreground="#A8998A" FontSize="11"/><TextBlock x:Name="StatusLabel" Text="慢一点，也在向前。" HorizontalAlignment="Right" Foreground="#A8998A" FontSize="11"/></DockPanel>
 </Grid>
</Window>
